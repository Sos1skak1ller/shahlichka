{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://x5.local/gaming-layer/challenge-screen.schema.json",
  "title": "ChallengeScreenView",
  "description": "Экран 2: текущий персональный недельный челлендж. Текст собран из шаблона (FR-010), generated_by ∈ {ml_ranker, rule, fallback} — не llm.",
  "type": "object",
  "additionalProperties": false,
  "required": ["user_id", "iso_week", "challenge"],
  "properties": {
    "user_id": { "type": "string" },
    "iso_week": { "type": "string", "pattern": "^\\d{4}-W\\d{2}$" },
    "challenge": {
      "type": ["object", "null"],
      "description": "null ⇒ на этой неделе активного челленджа нет",
      "additionalProperties": false,
      "required": ["challenge_id", "text", "mechanic_type", "generated_by", "params", "progress", "target", "status", "valid_to", "reward_amount"],
      "properties": {
        "challenge_id": { "type": "string" },
        "text": { "type": "string", "minLength": 1 },
        "mechanic_type": { "type": "string", "enum": ["category_repeat", "basket_growth", "streak_keep", "cross_chain"] },
        "generated_by": { "type": "string", "enum": ["ml_ranker", "rule", "fallback"] },
        "params": {
          "type": "object",
          "additionalProperties": false,
          "required": ["category", "n", "deadline"],
          "properties": {
            "category": { "type": "string" },
            "n": { "type": "integer", "minimum": 1 },
            "deadline": { "type": "string", "format": "date-time" }
          }
        },
        "progress": { "type": "integer", "minimum": 0 },
        "target": { "type": "integer", "minimum": 1 },
        "status": { "type": "string", "enum": ["active", "completed", "expired"] },
        "valid_to": { "type": "string", "format": "date-time" },
        "reward_amount": { "type": "number", "minimum": 0 },
        "within_budget": { "type": ["boolean", "null"], "description": "прошёл ли pre-check экономики (R5)" }
      }
    },
    "notes": {
      "type": "array",
      "items": { "type": "string", "enum": ["cold_start_fallback", "template_pool_exhausted", "anti_fatigue_switch"] }
    },
    "catalog": {
      "type": "array",
      "description": "Витрина форматов челленджей: что доступно сейчас и что откроется позже",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["template_id", "title", "mechanic_type", "category", "reward_amount", "available"],
        "properties": {
          "template_id": { "type": "string" },
          "title": { "type": "string" },
          "mechanic_type": { "type": "string", "enum": ["category_repeat", "basket_growth", "streak_keep", "cross_chain"] },
          "category": { "type": "string" },
          "reward_amount": { "type": "number", "minimum": 0 },
          "available": { "type": "boolean" },
          "lock_reason": { "type": ["string", "null"] }
        }
      }
    },
    "history": {
      "type": "array",
      "description": "Ранее выданные челленджи пользователя (без активного)",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["challenge_id", "text", "status", "reward_amount", "iso_week"],
        "properties": {
          "challenge_id": { "type": "string" },
          "text": { "type": "string" },
          "status": { "type": "string", "enum": ["completed", "expired", "rejected_economy"] },
          "reward_amount": { "type": "number", "minimum": 0 },
          "iso_week": { "type": "string", "pattern": "^\\d{4}-W\\d{2}$" }
        }
      }
    }
  }
}
